# Placeholder instance.env. Flat KEY=value, no quoting, no shell expansion.

# Required: the config schema this instance.env is written against.
# skgateway-deploy refuses to deploy a config repo whose CONFIG_SCHEMA is
# lower than the release's minimum supported schema, and tells you what to
# change. See docs/DEPLOYING.md#config-schema.
CONFIG_SCHEMA=1

# Required: the port this instance's gateway process listens on.
PORT=18780

# Required: the release tag this instance is pinned to. `skgateway-deploy
# --release` must match this unless `--force-release` is passed. Bumping
# this and merging the PR is how you upgrade.
RELEASE=skgateway-v1.0.0

# Optional: passed through to the Node process as Environment=NODE_OPTIONS=...
# NODE_OPTIONS=

# Secrets decryption method: ansible-vault | sops | none. Default: none.
# ansible-vault is what the rest of the fleet's SKStacks vaults already use.
SECRETS_METHOD=none

# Required only when SECRETS_METHOD=ansible-vault. Points at a password file
# that lives OUTSIDE this repo and is never committed.
# VAULT_PASSWORD_FILE=/home/example/.vault_pass_env/example_site_vault_pass

# ─── optional add-ons (all OFF by default; see docs/DEPLOYING.md) ───────────

# Shadow instance: a second gateway process for this instance, same release
# checkout, different port and config.
# SHADOW_ENABLED=1
# SHADOW_PORT=28880
# SHADOW_CONFIG=                 # defaults to <instance>/skgateway.shadow.yaml

# Tailnet ingress: a socket-activated proxy exposing this instance's port on
# one named network interface only.
# INGRESS_SOCKET=1
# TAILNET_INTERFACE=tailscale0
# INGRESS_PORT=                  # defaults to PORT above

# Canary loopback health check: a supervised SSH port-forward to a remote
# loopback backend, health-checked after each restart.
# CANARY=1
# CANARY_LOCAL_PORT=28882
# CANARY_REMOTE_HOST=example-remote-host
# CANARY_REMOTE_PORT=28880
# CANARY_SSH_CONFIG=             # defaults to ~/.ssh/config
