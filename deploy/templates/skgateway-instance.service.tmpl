[Unit]
Description=SKGateway instance: __INSTANCE__
Documentation=https://github.com/smilinTux/skgateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__RELEASE_DIR__
ExecStart=/usr/bin/env node __RELEASE_DIR__/src/index.mjs --port __PORT__
Environment=NODE_ENV=production
Environment=SKGATEWAY_CONFIG=__SKGATEWAY_CONFIG__
__NODE_OPTIONS_LINE__
EnvironmentFile=__SECRETS_ENV_PATH__
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skgateway-__INSTANCE__

[Install]
WantedBy=default.target
