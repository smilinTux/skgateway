[Unit]
Description=SKGateway shared shadow tailnet-only ingress proxy
Documentation=https://github.com/sk-oss/skgateway
BindsTo=skgateway-shared-tailnet.socket
After=skgateway-shared-shadow.service
Requires=skgateway-shared-shadow.service

[Service]
## Root-owned hardened supervised proxy
Type=simple
User=root
Group=root

## Security hardening - no privileges needed for TCP proxy
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

## Resource limits - connection and restart constraints
LimitNOFILE=65536
LimitNPROC=512
MemoryMax=256M
TasksMax=256
CPUQuota=50%

## Restart policy - bounded restarts with backoff
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

## Timeout settings
TimeoutStartSec=30s
TimeoutStopSec=10s

## socat proxy: Tailscale ingress -> loopback backend
## - TCP4-LISTEN: accepts from socket (bound to 100.80.180.78)
## - TCP4: forwards to 127.0.0.1:28880 (shared shadow gateway)
## - verify-chain: validates SSL/TLS if used (future proofing)
## - reuseaddr: allows quick restart
## - fork: handles concurrent connections
ExecStart=/usr/bin/socat \
    -T 300 \
    TCP4-LISTEN:0,reuseaddr,fork,bind=100.80.180.78 \
    TCP4:127.0.0.1:28880

## Environment
Environment=NODE_ENV=production
EnvironmentFile=-/etc/default/skgateway-shared-tailnet

## Capability bounding - none needed
CapabilityBoundingSet=
AmbientCapabilities=

## Path restrictions - read-only system, no home access
ReadOnlyPaths=/
ReadWritePaths=/var/log/skgateway /var/run/skgateway
InaccessiblePaths=/home /root /boot

## Standard I/O
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skgateway-shared-tailnet

[Install]
WantedBy=multi-user.target
