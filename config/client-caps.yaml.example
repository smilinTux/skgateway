## skgateway client caps, limits and alerts: the client_caps file of the
## evidence_budget_monitoring feature (docs/EVIDENCE-BUDGET-MONITORING.md).
## EXAMPLE ONLY. The real file lives in your cluster's config repo, next to the
## instance's skgateway.yaml, and is read only with the feature on.
## Client = the x-app header (pi sends SKGW_CLIENT there); "untagged" when absent.
## Re-read within 10 s of a save, no restart needed.
## enabled: false keeps client logging and the /status blocks but enforces no
## caps or limits and raises no cap or spike alerts.
enabled: true

## Calendar for daily caps, alert days and spend rows (IANA zone name).
timezone: UTC

## Untagged requests are always logged with their remote address (audit event
## client.untagged). reject_untagged: true answers them 400. Keep false until
## every caller sends x-app. untagged_grace_until only changes the audit warning text.
reject_untagged: false
untagged_grace_until: "2026-11-21"

## Local models: never capped, never counted (rate limits still apply).
exempt_backends: [local-qwen]

## Provider family = gateway backend id. Requested model patterns (glob, case
## insensitive) decide the family before routing. A model listed under several
## families (generic buckets) is refused only when all of them are over the cap.
families:
  codex: ["gpt-*", "sk-codex-*", "codex-*"]
  deepseek: ["deepseek-*", "sk-deepseek-*", "sk-s", "sk-m", "sk-l", "sk-xl"]
  zai: ["glm-*", "sk-glm-*", "sk-zai-*", "sk-s", "sk-m", "sk-l", "sk-xl"]

## Daily caps per client per family, days in `timezone`. calls = successful
## calls; tokens = input + output tokens as the metrics collector counts them
## (cached input not included). A missing or 0 value means no cap.
## Set them as a backstop well above normal use, so ordinary traffic is only
## logged and never blocked.
caps:
  default:
    codex:    { calls: 3000, tokens: 100000000 }
    deepseek: { calls: 6000, tokens: 25000000 }
    zai:      { calls: 3000, tokens: 5000000 }
  clients: {}
  ## example:
  ## clients:
  ##   research-bot: { deepseek: { calls: 1500 } }

## Calls per minute, sliding 60 s window. 0 means no limit.
rate_limits:
  default: { client_per_minute: 600, session_per_minute: 120 }
  clients: {}

## Alerts go to the outbox, one JSON line each; scripts/post-alerts.py posts
## them through your notify module. Each fires once per threshold per day; the
## fired state is the alert_fired table in metrics.db (survives restarts).
alerts:
  outbox: ./logs/alerts.jsonl
  # room: Ops                  # optional: copied onto each outbox record
  # notes:                     # optional: your wording appended to a summary
  #   cap: "Caps live in the cluster config repo."
  #   codex: "Codex work holds until the reset."
  #   deepseek_floor: "A top-up is the budget owner's call."
  #   stale: "Budget guards treat a stale backend as unavailable."
  #   spike: ""

  cap_percent: 80              # per client per family per unit
  spike_factor: 5              # last hour calls over 5x the trailing 24 h hourly average
  spike_min_calls: 200         # ... and at least this many calls in the last hour
  codex_used_percent: 80       # Codex primary or secondary window, from real call headers
  stale_hours: 2               # backend used in this window with no fresh provider snapshot

## DeepSeek balance: GET https://api.deepseek.com/user/balance (free, no tokens)
## every deepseek_balance_poll_minutes (0 = off). Alert below the floor (USD);
## null = no alert.
deepseek_balance_poll_minutes: 60
deepseek_balance_floor: null   # USD

## Dollars per million tokens. Lookup order: served model, requested model,
## backend id. Subscriptions (codex, zai) are 0: their budget is plan quota.
## Each entry is { input, output, cached } or { peak: {...}, offpeak: {...} }, with
## input = cache miss, cached = cache hit, output = output. A call is priced at its
## request time: peak when its UTC weekday is in peak_weekdays, its UTC date is not
## in holidays, and its UTC time is inside one of peak_windows_utc; otherwise off-peak.
prices_as_read: "2026-11-14 https://api-docs.deepseek.com/quick_start/pricing"
peak_windows_utc: ["01:00-04:00", "06:00-10:00"]
peak_weekdays: [Mon, Tue, Wed, Thu, Fri]
## Provider holidays (off-peak all day), YYYY-MM-DD in quotes.
holidays: []
prices:
  deepseek-v4-pro:
    peak:    { input: 1.32, output: 3.96, cached: 0.044 }
    offpeak: { input: 0.66, output: 1.98, cached: 0.022 }
  deepseek-flash:
    peak:    { input: 0.30, output: 1.20, cached: 0.006 }
    offpeak: { input: 0.15, output: 0.60, cached: 0.003 }
  deepseek-v4-flash:   # legacy name, bills at Flash
    peak:    { input: 0.30, output: 1.20, cached: 0.006 }
    offpeak: { input: 0.15, output: 0.60, cached: 0.003 }
  deepseek:            # any other deepseek model: v4-pro rates
    peak:    { input: 1.32, output: 3.96, cached: 0.044 }
    offpeak: { input: 0.66, output: 1.98, cached: 0.022 }
  codex:           { input: 0, output: 0, cached: 0 }
  zai:             { input: 0, output: 0, cached: 0 }
