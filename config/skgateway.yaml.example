## SKGateway configuration TEMPLATE (cold-machine bootstrap)
##
## HOW TO USE
##   cp config/skgateway.yaml.example config/skgateway.yaml
##   then edit the copy for this host (backend URLs, model catalog).
## The live config/skgateway.yaml is committed on the fleet, but on a fresh
## machine you materialize it from this template. See docs/COLD-BOOTSTRAP.md.
##
## SECRETS: this file holds NO secret values. It only names the env var that
## carries a secret (api_key_env) or the path to a credentials file
## (credentials_path). Real secrets arrive at runtime through a 0600
## EnvironmentFile (see docs/COLD-BOOTSTRAP.md), never in this YAML.
##
## Every field has a code-level default in src/config.mjs, so a section you
## delete falls back to that default. Reload the file at runtime with
## `kill -HUP <pid>` (config only; secrets and backend topology need a full
## restart).

server:
  port: 18780
  dashboard_port: 18781
  bind: 0.0.0.0

## Connection pooling: per-backend concurrency + queue limits. Keep the nvidia
## max at or below the upstream NIM concurrency ceiling (20 at time of writing).
pooling:
  default_max_concurrent: 20
  default_max_queue: 1000
  queue_timeout_ms: 300000
  ## Join logical routes that reach the same physical service. The domain key
  ## is the stable key shown by GET /queue. maxQueue: 0 means fail fast.
  # capacity_domains:
  #   local-model-service:
  #     members: [local, "reg:local-model"]
  #     max: 4
  #     maxQueue: 4
  #     queueTimeoutMs: 30000
  per_backend:
    nvidia:
      max: 20
      maxQueue: 500
    ollama:
      max: 50
      maxQueue: 200
    anthropic:
      max: 10
      maxQueue: 200

## Backends are matched by model name. A request routes to the lowest priority
## NUMBER that lists a matching model (priority 1 wins), failing over to the next
## eligible backend on 5xx. Replace the example host IPs and ports below with the
## reachable upstreams on THIS network.
backends:
  ## Local OpenAI-compatible server (example: an ornith/llama.cpp box).
  local:
    url: http://LOCAL_LLM_HOST:8082/v1        # e.g. http://192.168.0.100:8082/v1
    auth_type: none
    models:
      - ornith-tiny
      - ornith-1.0-9b
      - qwen3.6-27b-abliterated
    priority: 1

  ## NVIDIA NIM (hosted). REQUIRES a secret. auth_type api_key reads the key from
  ## the env var NAMED by api_key_env (never the value here). Provision
  ## NVIDIA_API_KEY via the secrets EnvironmentFile (docs/COLD-BOOTSTRAP.md).
  nvidia:
    url: https://integrate.api.nvidia.com/v1
    auth_type: api_key
    api_key_env: NVIDIA_API_KEY               # env var name only, NOT the key
    models:
      - qwen/qwen3.5-122b-a10b
      - openai/gpt-oss-20b
      - deepseek-ai/deepseek-v4-flash
      # Prune to models your NVIDIA account can actually serve.
    priority: 1

  ## OpenCode Zen (hosted, card C8 / 6cc8aac3). Serves both paid frontier
  ## models AND a rotating free tier (big-pickle, the *-free ids). Follows the
  ## openrouter pattern below, NOT the nvidia one above: `discovery: "free"`
  ## with NO static `models:` list here. A static list is exactly what rotted
  ## on nvidia and produced dead advertised ids (parent card 767adc4e):
  ## models.dev's opencode registry shows 27 zero-cost models and only 7 of
  ## them are actually live on Zen right now (measured 2026-08-15), a 74
  ## percent turnover that would stale a hand-maintained list within days.
  ##
  ## Two upstream sources feed the discovered catalog for this backend, not
  ## one: Zen's own /v1/models says WHICH ids are being served right now, but
  ## carries no pricing or capability data ({id, object, created, owned_by}
  ## only). models.dev's `opencode` registry key supplies the model card
  ## (cost, context/output limits, tool_call, reasoning) and is the ONLY
  ## source used to decide "free": `cost.input == 0 && cost.output == 0`,
  ## never an id suffix. big-pickle is free with no `-free` suffix; it is the
  ## reason this backend exists. Six of the other seven currently-live free
  ## ids do end in `-free`, which is exactly why a suffix rule would have
  ## looked right in testing and then silently dropped big-pickle in
  ## production. See src/discovery/providers/opencode.mjs for the join.
  ##
  ## auth_type api_key is OPTIONAL here in practice: measured 2026-08-15, both
  ## GET /v1/models and POST /v1/chat/completions return 200 with zero auth
  ## headers. OPENCODE_API_KEY (documented by the provider) is still wired as
  ## an optional bearer, because unauthenticated access is exactly the kind of
  ## thing that gets rate limited without notice; a live 429
  ## (FreeUsageLimitError) was in fact observed against the free tier during
  ## the measurement session for this card. A 401/429 degrades cleanly
  ## (treated as a normal fetch/attempt failure) and never poisons the model
  ## lifecycle store.
  ##
  ## TRUST ZONE (card N1): tagged zone 2 / free-remote on every discovered
  ## card (see opencode.mjs's buildCard()). Unauthenticated free inference to
  ## a third party is the least private option this gateway has: the data
  ## itself is the payment, and we are not even identified to the provider.
  ## Never route `require: {sensitivity: secret}` traffic here.
  ##
  ## GATED, DO NOT ENABLE YET. This backend is not wired into production
  ## discovery in this change (src/index.mjs's refreshCatalog does not yet
  ## pass an opencodeFetch opt through), and per card C8's acceptance
  ## criteria it must not be enabled at all until cards C1 (7330bb05), C2
  ## (affa0aac) and C3 (1f65cf45) are confirmed landed AND OpenRouter's free
  ## tier is confirmed recovered on THIS host (openrouter's advertised count
  ## > 0, not stuck at the all-eol state those cards fixed). That is a
  ## deliberate, separate operational decision, not a code gap to work
  ## around here.
  # opencode:
  #   url: https://opencode.ai/zen/v1
  #   auth_type: api_key
  #   api_key_env: OPENCODE_API_KEY            # env var name only, NOT the key; optional bearer
  #   auth_optional: true                      # card C15: this provider genuinely serves
  #                                            # unauthenticated traffic (measured 2026-08-15).
  #                                            # Declaring it here means the gateway is not left
  #                                            # inferring intent from an absent env var, which is
  #                                            # how a caller's own bearer used to end up upstream.
  #   discovery: free                          # free | all -- no static `models:` list, see above
  #   max_concurrent: 10

  ## Claude models via the LOCAL claude-code-api wrapper (claude --print on
  ## 127.0.0.1:18782). auth_type none: the wrapper IS Claude Code and bills as
  ## first-party subscription. Do NOT point this at api.anthropic.com.
  anthropic:
    url: http://127.0.0.1:18782/v1
    auth_type: none
    models:
      - claude-opus-4-8
      - claude-opus-4-7
      - claude-sonnet-4-6
      - claude-haiku-4-5
    priority: 2
    timeout_ms: 120000                         # fail fast if the wrapper wedges

  ## OPTIONAL degraded fallback for claude-* when the :18782 wrapper is down.
  ## auth_type oauth reads the Claude Code OAuth token from credentials_path (a
  ## file secret, not committed). Higher priority NUMBER = only used after the
  ## wrapper fails. Direct api.anthropic.com billing is third-party extra-usage,
  ## so treat this as a last resort, not steady state. Remove if unwanted.
  anthropic-direct:
    url: https://api.anthropic.com/v1
    auth_type: oauth
    credentials_path: ~/.claude/.credentials.json   # path to creds file, not a token
    models:
      - claude-opus-4-8
      - claude-opus-4-7
      - claude-sonnet-4-6
      - claude-haiku-4-5
    priority: 8
    timeout_ms: 120000

  ## Optional local Ollama.
  ollama:
    url: http://LOCAL_LLM_HOST:11434/v1        # e.g. http://192.168.0.100:11434/v1
    auth_type: none
    models:
      - "dolphin-*"
    priority: 3

tools:
  guaranteed:
    - exec
    - read
    - write
    - edit
    - message
  max_budget: 16
  fallback_budget: 8
  call_limit: 10

## Streaming to non-streaming auto-flip for upstream stability on large or
## tool-heavy turns. See src/config.mjs for the full trigger set.
streaming:
  default: true
  force_header: x-skgateway-nonstream
  auto_nonstream:
    enabled: true
    trigger_if_body_bytes_ge: 40000
    trigger_if_messages_ge: 6
    trigger_if_tool_call_history_ge: 3
    aggressive_models:
      - deepseek-ai/deepseek-v4-flash

sanitizer:
  max_system_bytes: 40000
  max_body_bytes: 120000
  keep_start: 2
  keep_end: 12
  strip_thinking: true

## Optional per-model context limits. Formula: max_body_bytes = context_tokens
## * 4 bytes * 0.80; max_system_bytes = max_body_bytes * 0.40. Add entries as
## needed; models without an entry use the sanitizer defaults above.
model_limits:
  ornith-1.0-9b:   { max_body_bytes: 419000, max_system_bytes: 168000 }
  ornith-1.0-35b:  { max_body_bytes: 800000, max_system_bytes: 320000 }

metrics:
  enabled: true
  db_path: ./data/metrics.db                   # relative resolves under repo root
  retention_days: 90
  token_tracking: true
  cost_tracking: true
  ## Per-model pricing (USD per 1,000,000 tokens). Local/hosted-free models are 0.
  pricing:
    claude-opus-4-7:
      input: 15.00
      output: 75.00
      cache_read: 1.50
      cache_write: 3.75
    claude-sonnet-4-6:
      input: 3.00
      output: 15.00
      cache_read: 0.30
      cache_write: 0.375
    default_local:
      input: 0
      output: 0

siem:
  enabled: true
  outputs:
    - type: file
      path: ./logs/audit.jsonl                 # relative resolves under repo root
      rotate_mb: 100
    ## Optional remote syslog sink (SIEM). Disabled unless present + enabled,
    ## or turned on via SKGATEWAY_SYSLOG_* env vars. See docs/SIEM.md.
    # - type: syslog
    #   enabled: true
    #   host: SYSLOG_HOST
    #   port: 514
    #   protocol: udp            # udp | tcp | tls | unix
    #   format: cef              # cef | json
    ## Optional Elasticsearch / OpenSearch sink (ships the event stream via the
    ## _bulk API). Both engines use the identical adapter; use type: opensearch
    ## for clarity if you prefer. Disabled unless present + enabled with an
    ## endpoint, or turned on via SKGATEWAY_ES_* env vars. See docs/SIEM.md.
    ## Auth is referenced by ENV-VAR NAME, never a literal secret: set e.g.
    ## SKGATEWAY_ES_API_KEY in the environment and name it here.
    # - type: elasticsearch      # or: opensearch
    #   enabled: true
    #   endpoint: https://ES_HOST:9200
    #   index: skgateway-siem-%DATE%   # %DATE% -> YYYY.MM.DD (daily indices)
    #   batch_size: 100
    #   flush_ms: 5000
    #   api_key_env: SKGATEWAY_ES_API_KEY   # NAME of the env var holding the key
    #   # bearer_token_env: SKGATEWAY_ES_BEARER   # OpenSearch/JWT alternative
    #   # auth_header_env: SKGATEWAY_ES_AUTH      # raw Authorization value (e.g. "Basic ...")

## Passive prompt classification (labels only, never reroutes). Safe on hot path.
classification:
  enabled: true
  classifier: heuristic
  gate: false

## CapAuth agent-identity resolution. require_agent_id is the AUTH GATE: leave
## false to keep the hot path open; set true to reject anonymous callers (403).
identity:
  enabled: true
  allow_anonymous: true
  require_agent_id: false

## Authorization is disabled unless enforce is explicitly enabled. The SKLegal
## qualification lane is separately explicit. Its exact synthetic scope comes
## only from this trusted process configuration, never from request headers.
## Service and request-local credentials are read from the environment and the
## incoming Authorization header. Do not place either credential in this file.
authz:
  enforce: false
  url: null
  cache_ttl_ms: 5000
  timeout_ms: 2000
  trust_internal: true
  sklegal_qualification:
    enabled: false
    ## URL may come from SKLEGAL_CAPAUTH_AUTHZ_ENDPOINT. The service credential
    ## comes only from SKLEGAL_AUTHZ_SERVICE_TOKEN.
    url: null
    routes: []
    ## Example synthetic route shape:
    # routes:
    #   - method: POST
    #     path: /v1/chat/completions
    #     subject: synthetic-agent
    #     resource:
    #       tenant_id: synthetic-tenant
    #       matter_id: synthetic-matter
    #       material_id: synthetic-material
    #       material_version: "1"
    #       route_id: synthetic-route
    #     context:
    #       purpose: research
    #       classification: public
    #       privilege: none
    #       ethical_wall: clear

## Per-agent model routing rules (P4.3). Pin a resolved agent identity to a
## specific model or alias/role, overriding the model the caller asked for. The
## target is either a concrete model id served by a backend above, or an
## alias/role the skmodels registry resolves (sk-default, sk-code, ornith-tiny,
## ...). Agent ids are case-insensitive. Explicit x-sk-context / x-sk-service /
## x-sk-role request headers still win; only the model field is pinned. Leave
## per_agent empty (the default) for unchanged routing. NO secrets here, just
## agent names mapped to model/alias labels.
## Capability-aware routing master gate (design doc 2026-08-08, cards
## P4.1-P4.4). Governs BOTH a registry role whose target is the "@match"
## marker (rankModels() picks a ranked candidate chain from the discovered
## catalog against that role's requirements block) and the per-request
## x-sk-require header escape hatch. Default OFF (code default in
## src/config.mjs): with it off, an "@match" role and the header are both
## inert, no rank call, no new candidates, no added latency. Observe
## rankings via the loopback-only GET /admin/models/rank suggest-only API
## before turning this on.
routing:
  per_agent: {}
    # lumina: sk-default            # Queen routes to the default model
    # jarvis: qwen/qwen3.5-122b-a10b  # pin an agent to a concrete model
    # herald: ornith-tiny           # mechanical/aux agent → small non-thinking model
  # match_enabled: true

dashboard:
  enabled: true
  refresh_ms: 5000

## Dynamic provider model discovery (SKGateway dynamic-provider-model-discovery,
## design doc 2026-07-25). Periodically queries each declared backend's
## model-list endpoint and folds newly seen models into the effective model
## set, instead of relying solely on the static `models` arrays under backends.
discovery:
  enabled: true
  refresh_seconds: 3600            # how often to re-poll each provider (1h)
  providers:
    nvidia:     { enabled: true, free_only: true, chat_only: true }
    openrouter: { enabled: true, free_only: true, chat_only: true }
    ## opencode: { enabled: true, free_only: true, chat_only: true }
    ## Commented out on purpose (card C8 / 6cc8aac3). NOT wired into
    ## production discovery yet in this change (refreshCatalog in
    ## src/index.mjs doesn't pass an opencodeFetch opt through), and must not
    ## be enabled at all until C1/C2/C3 have landed AND OpenRouter's free
    ## tier is confirmed recovered on this host. See the `backends.opencode`
    ## comment block above for the full reasoning.

  ## EOL probe sweep (card P2.3, design doc 2026-08-08 §5.2). A budgeted,
  ## off-request-path warm probe against candidate models (chosen from the
  ## model lifecycle store, model_catalog_store.mjs) so a model that stopped
  ## appearing in a provider's catalog listing, or whose last_verified_at is
  ## null and can never be promoted by catalog-presence alone, still gets an
  ## affirmative live/dead answer instead of drifting on absence-accounting
  ## alone. Piggybacks on the discovery refresh cadence above, not a separate
  ## timer: each refresh cycle checks whether a full probe_seconds has elapsed
  ## since the last sweep (tracked in the discovery cache) and only then
  ## spends its budget.
  #
  # probe_seconds:    0        # cadence: run the sweep at most once every N
  #                             # seconds. 0 (the default) disables the sweep
  #                             # entirely; nothing below has any effect while
  #                             # this is 0. 86400 (daily) matches probe.mjs's
  #                             # DEFAULT_PROBE_SECONDS.
  # probe_budget:      20      # max models probed in a single sweep (matches
  #                             # probe.mjs's DEFAULT_PROBE_BUDGET). Each probe
  #                             # is a real upstream completion call, so this
  #                             # is a real-cost ceiling per sweep, not a
  #                             # display limit: raise it deliberately.
  # probe_timeout_ms:  15000   # hard per-model abort timeout for a probe call
  #                             # (matches probe.mjs's DEFAULT_PROBE_TIMEOUT_MS).
  #
  ## Before setting probe_seconds > 0 anywhere it matters: confirm the cadence
  ## gate and budget behave as expected on a low-stakes node first. A live
  ## sweep makes real calls against every candidate model it selects, up to
  ## probe_budget, once the cadence window is due.

## ── Sovereignty: job sensitivity to model trust zone (card 45d7a30b / N1) ──
##
## Two axes, deliberately not conflated:
##   job sensitivity   public / internal / secret. How bad is it if this
##                     content leaves our hardware. NOT the Joule size x risk
##                     grade, which measures blast radius if the work goes
##                     wrong. A one-line prompt holding a private key is tiny
##                     blast radius and maximum sensitivity.
##   model trust zone  0 sovereign local, 1 paid-contractual cloud,
##                     2 free-remote. Derived from the provider's verified
##                     data-retention posture (see config/model-cards.overrides
##                     .yaml `providers:`), not asserted here.
##
## This DELIBERATELY INVERTS the cost tier ladder. That ladder prefers
## free-remote because free is cheaper; it measures COST. On TRUST, free-remote
## is the worst option we have: verified 2026-08-15, nvidia, openrouter and
## opencode all train on submitted content, while Anthropic's commercial terms
## prohibit it. Free is not a discount, it is a different payment method and
## the payment is the data. Both ladders are right about different questions.
##
## Enforcement ships OFF. With it off the gate SHADOW LOGS every decision it
## would have changed (grep for `sensitivity_gate` / "would block (shadow)"),
## so a soak shows the blast radius before anything starts returning 503.
## Turning it on blind risks 503s for real traffic; leaving it off risks a
## silent sovereignty crossing. Only one of those is reversible in a hurry,
## which is why the soak comes first.
##
## When enforcement is on and no candidate satisfies the ceiling, the request
## FAILS CLOSED with 503. It never falls back across a zone. A fallback that
## quietly downgrades sovereignty looks healthy, which is exactly how
## sk-default ended up serving from cloud after its local backend died.
##
## !! sensitivity_enforced ALONE DOES NOTHING. IT REQUIRES match_enabled. !!
##
## The gate only applies to a request that DECLARED a sensitivity, and the only
## thing that puts a declared sensitivity on a live request is the
## `x-sk-require` header, which src/index.mjs parses through
## resolveRequestRequirements(). That function hard-returns undefined while
## routing.match_enabled is off. So with match_enabled off, no request ever
## carries a sensitivity, requestZoneCeiling() always returns null, and this
## flag is inert whether it is true or false.
##
## Nothing tells you. There is no error, no warning, and the shadow soak
## reports zero would-be blocks, which reads exactly like "nothing needed
## blocking" rather than "the gate never ran". Rollout order is therefore:
##
##   1. match_enabled: true          (requests can now declare a sensitivity)
##   2. sensitivity_enforced: false  (soak; grep sensitivity_gate / "shadow")
##   3. sensitivity_enforced: true   (enforce, once the soak is clean)
##
## Step 1 is not optional and is not just for @match roles. Note also that
## match_enabled is read ONCE at boot in index.mjs (module scope), unlike
## sensitivity_enforced and buckets_enabled which are re-read per request, so
## flipping it needs a restart rather than a SIGHUP.
# routing:
#   sensitivity_enforced: false

## ── Bucket pools: address the WORK, not a model (card 2ba73bf9 / C9) ──
##
## A bucket id is an ordinary model string, so a harness sets ONE value and
## nothing else changes:   model: "sk-l-internal"
##
##   sk-<model_class>-<sensitivity>
##     model_class   S/M/L/XL, the capability FLOOR for the work. Taken from
##                   the canonical grade vocabulary (docs/specs/joule-grade-
##                   vocabulary.json), where the grader has already computed it
##                   as CLASS[max(size_rank, risk_rank)]. Floor is HARD, never
##                   route below it. Ceiling is SOFT, a bigger model is fine.
##     sensitivity   public/internal/secret, DATA EXPOSURE. Resolves to a trust
##                   zone ceiling via the N1 gate.
##
## NOTE two different things are named S/M/L/XL and they are NOT the same. The
## bucket's model_class is about the WORK ("XL: architecture, changes contracts
## others depend on"). A model card's `size_class` is PARAMETER COUNT (a 9B is
## M, a 550B is XL). Parameter size is a useful PRIOR for meeting a capability
## floor and is not the same claim, so a measured capability always wins over it.
##
## Why buckets: every rot problem this gateway has had came from something
## naming a model id that later went stale (the static nvidia list, the
## hardcoded failover model, roles pinned to one backend). A bucket cannot rot.
## Only its membership changes, and membership is derived rather than written
## down. The tradeoff is that you stop knowing which model answered, so the
## system has to care instead: an empty pool FAILS CLOSED with 503 listing what
## was excluded and why, and never substitutes across a class floor or a
## sensitivity ceiling.
##
## Ships OFF. With it off a bucket id is not special and routes as it would
## today. Turn it on only after reviewing what the pools actually resolve to.
##
## A MISTYPED BUCKET ID IS REFUSED, not routed. With this flag ON, an id shaped
## like a bucket that is not one (`sk-xl-secrets`, `sk-xxl-secret`) returns 400
## `invalid_bucket_id` listing the valid buckets. It used to return 200: an
## unparseable bucket id fell through to registry routing, matched on the bare
## `sk-` prefix, and resolved through defaults.role to sk-auto, so one
## transposed letter served the request from an arbitrary model with no
## capability floor and no trust-zone ceiling. Ids the registry explicitly
## defines are exempt, so a deliberately-named role is never mistaken for a
## typo, and ids that are not bucket-shaped (sk-default, sk-auto, sk-heavy,
## sk-vision, ...) are untouched.
##
## Bucket MEMBERSHIP depends on the provider posture block in
## config/model-cards.overrides.yaml. `internal` (ceiling zone 1) admits our own
## hardware plus any provider with a verified `contractual-zero` retention
## posture, which today is Anthropic only. If that block is missing or
## unreadable, every remote model degrades to zone 2 and `internal` silently
## narrows to sovereign-only, which looks like a working strict policy rather
## than a broken one.
# routing:
#   buckets_enabled: false
